  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/muzammiliqbalofficial/zeroupload/issues"
  },
  "homepage": "https://github.com/muzammiliqbalofficial/zeroupload#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "pdf-lib": "^1.17.1",
    "wrangler": "^4.151.2"
  }
}
