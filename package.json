{
  "name": "zeroupload",
  "version": "1.0.0",
  "description": "Local PDF tools, workflow documentation, and Cloudflare D1 support",
  "scripts": {
    "build": "python scripts/build_content.py",
    "check": "python scripts/verify_content.py",
    "test": "node --test tests/worker.test.mjs",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "test:browser": "node scripts/verify_browser.cjs",
    "deploy:check": "wrangler deploy --dry-run --outdir artifacts/worker-build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muzammiliqbalofficial/zeroupload.git"
  },
  "keywords": [],
  "author": "",
