/*
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Content-Type-Options: nosniff

# Static assets cache lifetimes: set to 1 year / 30 days with stale-while-revalidate
# to satisfy Lighthouse caching audits while allowing automatic background updates.
/css/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.svg
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=31536000, immutable

/og-image.svg
  Cache-Control: public, max-age=31536000, immutable

/manifest.json
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# This exact file only changes if the font itself is intentionally swapped
# out, so it can be cached far longer than the other assets.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/ads.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
